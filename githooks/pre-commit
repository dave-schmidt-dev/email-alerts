#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Running syntax check..."
python3 -m compileall -q email_alert tests

if command -v ruff >/dev/null 2>&1; then
  echo "[pre-commit] Running ruff..."
  ruff check .
else
  echo "[pre-commit] ruff not found; skipping lint (optional)"
fi

echo "[pre-commit] Running unit tests..."
python3 -m unittest

echo "[pre-commit] OK"

