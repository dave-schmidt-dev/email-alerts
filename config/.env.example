# Required for real sends (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Defaults
EMAIL_ALERT_TO=
EMAIL_ALERT_FROM=

# Optional: where runtime state lives (queue, logs, etc.)
# Default: ~/.agent/state/email-alerts
EMAIL_ALERT_STATE_DIR=

# Failure behavior
# - queue_ok (default): queue on send failure and exit 0
# - queue_fail: queue on send failure and exit non-zero
EMAIL_ALERT_ON_FAIL=queue_ok

# Rate limit & dedupe (seconds)
EMAIL_ALERT_RATE_LIMIT_SECONDS=60
EMAIL_ALERT_DEDUPE_SECONDS=60

# Logging
EMAIL_ALERT_LOG_LEVEL=INFO
# Default: ${EMAIL_ALERT_STATE_DIR}/email-alert.log
EMAIL_ALERT_LOG_FILE=
EMAIL_ALERT_LOG_MAX_BYTES=1000000
EMAIL_ALERT_LOG_BACKUP_COUNT=3

# Modes
EMAIL_ALERT_TEST_MODE=false
EMAIL_ALERT_E2E_TEST=false
EMAIL_ALERT_E2E_BYPASS_RATE_LIMIT=false

# SMTP (advanced)
# Some networks block outbound SMTP on 587; 465 may work better in those cases.
EMAIL_ALERT_SMTP_HOST=smtp.gmail.com
EMAIL_ALERT_SMTP_PORTS=587,465
EMAIL_ALERT_SMTP_TIMEOUT_SECONDS=20
